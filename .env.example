# HydroSense AI — Environment Configuration
# Copy this file to .env and provide your credentials where appropriate.
# Note: Free APIs (Open-Meteo, IMD GeoServer WFS, OpenStreetMap) work automatically without keys.

# Backend API URL for Vite Frontend Client
VITE_API_URL=http://127.0.0.1:8000

# --- Alert email delivery (SMTP) ---
# Required for Generate Alert to send a real email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-sender@gmail.com

# --- MongoDB alert persistence ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=hydrasense
MONGODB_ALERTS_COLLECTION=alerts
MONGODB_DISMISSED_COLLECTION=dismissed_alerts

# --- Official India Meteorological Department (IMD) API Portal ---
# Registration: https://api.imd.gov.in/public/register.php
# Login: https://api.imd.gov.in/public/login.php
# Header: x-api-key
IMD_API_KEY=
# Header: Authorization: Bearer <jwt_token>
IMD_JWT_TOKEN=

# --- Copernicus Data Space Ecosystem (CDSE) / Sentinel-1 SAR ---
# Portal: https://dataspace.copernicus.eu/
# OAuth2 client credentials for Sentinel-1 C-band SAR radar imagery
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# --- ISRO MOSDAC (Meteorological & Oceanographic Satellite Data) ---
# Portal: https://www.mosdac.gov.in/
# Access for INSAT-3DR / INSAT-3D Hydro-Estimator & QPE data
MOSDAC_USER_EMAIL=
MOSDAC_API_KEY=
